// Rule:    SSH Password Guessing From One Source
// Sigma:   rules/linux/sshd/lnx_sshd_brute_force_password_guessing.yml
//          correlation id fa9d4e52-52d4-4298-9b79-892f13090910 (event_count >= 5 per SourceIp in 10m)
// Author:  John Denis Nyagah
// Why hand-written: pySigma-backend-kusto 1.0.1 cannot convert Sigma correlation rules, and the
// Syslog table has no source-IP column, so SourceIp is extracted from SyslogMessage here.
// Window:  sliding, like the Sigma rule: every failure is the end of a 10-minute window, and the
// failures from the same IP inside that window are counted. bin(TimeGenerated, 10m) would use
// fixed buckets and miss a burst that straddles a bucket edge.
// Output:  one row per source IP that reached the threshold.
let window = 10m;
let threshold = 5;
let failures = Syslog
    | where ProcessName =~ "sshd" and SyslogMessage contains "Failed password for "
    | extend SourceIp = extract(@" from ([0-9A-Fa-f.:]+?)(?: port \d+|:? |$)", 1, SyslogMessage)
    | where isnotempty(SourceIp)
    | project TimeGenerated, SourceIp;
failures
| join kind=inner (failures | project WindowEnd = TimeGenerated, SourceIp) on SourceIp
| where TimeGenerated between ((WindowEnd - window) .. WindowEnd)
| summarize FailuresInWindow = count(), WindowStart = min(TimeGenerated) by SourceIp, WindowEnd
| where FailuresInWindow >= threshold
| summarize
    FirstSeen = min(WindowStart),
    LastSeen = max(WindowEnd),
    MaxFailuresInWindow = max(FailuresInWindow)
    by SourceIp
