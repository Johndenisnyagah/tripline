// Rule:    Windows Password Spraying From One Source
// Sigma:   rules/windows/security/win_security_password_spraying.yml
//          correlation id 9d1e7607-ba16-4972-92df-7aa06a25f3dd (value_count >= 5 distinct
//          TargetUserName per IpAddress in 10m)
// Author:  John Denis Nyagah
// Why hand-written: pySigma-backend-kusto 1.0.1 cannot convert Sigma correlation rules.
// Window:  sliding, like the Sigma rule. Account names are lower-cased before counting, so
// Administrator and administrator are one account (as in the SQLite harness). Failures with
// no source address ("-") or from loopback are excluded, as in the Sigma base rule.
// Output:  one row per source address that failed against >= 5 distinct accounts in a window.
let window = 10m;
let threshold = 5;
let failures = SecurityEvent
    | where EventID == 4625
    | where isnotempty(IpAddress) and IpAddress !in ("-", "127.0.0.1", "::1")
    | project TimeGenerated, IpAddress, Account = tolower(TargetUserName);
failures
| join kind=inner (failures | project WindowEnd = TimeGenerated, IpAddress) on IpAddress
| where TimeGenerated between ((WindowEnd - window) .. WindowEnd)
| summarize DistinctAccounts = count_distinct(Account), WindowStart = min(TimeGenerated)
    by IpAddress, WindowEnd
| where DistinctAccounts >= threshold
| summarize
    FirstSeen = min(WindowStart),
    LastSeen = max(WindowEnd),
    MaxDistinctAccounts = max(DistinctAccounts)
    by IpAddress
