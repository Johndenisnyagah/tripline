Sysmon
| where EventID == 1 and ((((Image endswith "\\powershell.exe" or Image endswith "\\pwsh.exe") or (OriginalFileName in~ ("PowerShell.EXE", "pwsh.dll"))) and (CommandLine contains " -e " or CommandLine contains " /e " or CommandLine contains " –e " or CommandLine contains " —e " or CommandLine contains " ―e " or CommandLine contains " -en " or CommandLine contains " /en " or CommandLine contains " –en " or CommandLine contains " —en " or CommandLine contains " ―en " or CommandLine contains " -enc " or CommandLine contains " /enc " or CommandLine contains " –enc " or CommandLine contains " —enc " or CommandLine contains " ―enc " or CommandLine contains " -enco" or CommandLine contains " /enco" or CommandLine contains " –enco" or CommandLine contains " —enco" or CommandLine contains " ―enco" or CommandLine contains " -ec " or CommandLine contains " /ec " or CommandLine contains " –ec " or CommandLine contains " —ec " or CommandLine contains " ―ec ")) and (not(CommandLine contains " -Encoding ")))
