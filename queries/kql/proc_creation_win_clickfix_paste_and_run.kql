Sysmon
| where EventID == 1 and (ParentImage endswith "\\explorer.exe" and ((Image endswith "\\powershell.exe" or Image endswith "\\pwsh.exe" or Image endswith "\\mshta.exe" or Image endswith "\\cmd.exe") or (OriginalFileName in~ ("PowerShell.EXE", "pwsh.dll", "MSHTA.EXE", "Cmd.Exe"))) and (CommandLine contains "#" or CommandLine contains "                    " or (CommandLine contains " -w hidden" or CommandLine contains " /w hidden" or CommandLine contains " –w hidden" or CommandLine contains " —w hidden" or CommandLine contains " ―w hidden" or CommandLine contains " -win hidden" or CommandLine contains " /win hidden" or CommandLine contains " –win hidden" or CommandLine contains " —win hidden" or CommandLine contains " ―win hidden" or CommandLine contains " -windowstyle hidden" or CommandLine contains " /windowstyle hidden" or CommandLine contains " –windowstyle hidden" or CommandLine contains " —windowstyle hidden" or CommandLine contains " ―windowstyle hidden" or CommandLine contains " -w h " or CommandLine contains " /w h " or CommandLine contains " –w h " or CommandLine contains " —w h " or CommandLine contains " ―w h ") or (CommandLine contains "http://" or CommandLine contains "https://")))
