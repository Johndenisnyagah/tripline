Sysmon
| where EventID == 10 and ((TargetImage endswith "\\lsass.exe" and (GrantedAccess in~ ("0x1010", "0x1410", "0x1418", "0x1438", "0x143a", "0x1f0fff", "0x1f1fff", "0x1f2fff", "0x1f3fff", "0x1fffff", "0x40"))) and (not(((SourceImage in~ ("C:\\Windows\\system32\\wininit.exe", "C:\\Windows\\system32\\csrss.exe", "C:\\Windows\\system32\\services.exe", "C:\\Windows\\system32\\lsm.exe", "C:\\Windows\\system32\\svchost.exe")) or (SourceImage contains "\\Windows Defender\\" and SourceImage endswith "\\MsMpEng.exe")))))
