Sysmon
| where EventID == 1 and ((Image endswith "\\certutil.exe" or OriginalFileName =~ "CertUtil.exe") and (CommandLine contains " -urlcache" or CommandLine contains " /urlcache" or CommandLine contains " –urlcache" or CommandLine contains " —urlcache" or CommandLine contains " ―urlcache" or CommandLine contains " -verifyctl" or CommandLine contains " /verifyctl" or CommandLine contains " –verifyctl" or CommandLine contains " —verifyctl" or CommandLine contains " ―verifyctl" or CommandLine contains " -f " or CommandLine contains " /f " or CommandLine contains " –f " or CommandLine contains " —f " or CommandLine contains " ―f ") and CommandLine contains "http")
